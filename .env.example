# Copy this file to .env and customize the values below
# Values are consumed by .github/scripts/run-local-transparency.sh

# Registry/repository defaults
REGISTRY=ghcr.io/senticor-ai
GITHUB_REPOSITORY=Senticor-ai/jena-docker

# Container CLI preferences (docker, podman, nerdctl, ...)
# When set to podman the scripts automatically skip imagetools
CONTAINER_CLI=podman
SKIP_IMAGETOOLS=1
IMAGETOOLS_OPTIONAL=1

# Image versions (leave blank to auto-detect from Dockerfiles)
JENA_VERSION=
FUSEKI_VERSION=
JENA_IMAGE_REF=                # Optional: override full image ref, e.g. localhost/jena:test
JENA_FUSEKI_IMAGE_REF=

# GitHub Container Registry credentials (read:packages scope)
# These are optional but required for registry pulls & Cosign.
# Token must include read:packages (fine-grained PAT) and access to senticor-ai packages.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_your_token_with_read_packages
# Authfile path that both podman/docker and cosign should share
GHCR_AUTHFILE=$HOME/.docker/config.json
